PROC_SYS="${LFAPP_PROC_SYS:-/proc/sys}"
SYSCTL_CONF_PATH="${LFAPP_SYSCTL_CONF:-/etc/sysctl.conf}"
MODULE_DIR="${LFAPP_MODULE_DIR:-/lib/modules}"
TUNING_APPLY="${LFAPP_TUNING_APPLY:-/usr/share/liquid-formula/apply-tuning.sh}"
TUNING_INIT_DIR="${LFAPP_INIT_DIR:-/etc/init.d}"
OPENWRT_RELEASE_FILE="${SBF_OPENWRT_RELEASE:-/etc/openwrt_release}"
TUNING_MANAGED_RE='^[[:space:]]*(net\.ipv4\.tcp_fastopen|net\.core\.default_qdisc|net\.ipv4\.tcp_congestion_control|net\.ipv4\.tcp_max_syn_backlog)[[:space:]]*='

_proc_value() {
	local path="$PROC_SYS/$1"
	[ -r "$path" ] || return 1
	head -n 1 "$path" 2>/dev/null | tr -d '\r'
}

# 模块可能还没加载, 所以既看已注册的列表也看磁盘上的 .ko。
_module_present() {
	local name="$1" release
	release="$(uname -r 2>/dev/null)"
	[ -n "$release" ] || return 1
	set -- "$MODULE_DIR/$release/$name".ko*
	[ -e "$1" ]
}

_openwrt_release() {
	local line value
	[ -r "$OPENWRT_RELEASE_FILE" ] || return 1
	while IFS= read -r line; do
		case "$line" in
			DISTRIB_RELEASE=*)
				value=${line#DISTRIB_RELEASE=}
				case "$value" in
					\'*\') value=${value#\'}; value=${value%\'} ;;
					\"*\") value=${value#\"}; value=${value%\"} ;;
				esac
				printf '%s\n' "$value"
				return 0
				;;
		esac
	done < "$OPENWRT_RELEASE_FILE"
	return 1
}

_tuning_status() {
	local fastopen qdisc cc backlog available cake_mod bbr_mod conflict openwrt_release
	local irq_enabled irq_installed irq_running

	fastopen="$(_proc_value net/ipv4/tcp_fastopen)" || fastopen=''
	qdisc="$(_proc_value net/core/default_qdisc)" || qdisc=''
	cc="$(_proc_value net/ipv4/tcp_congestion_control)" || cc=''
	backlog="$(_proc_value net/ipv4/tcp_max_syn_backlog)" || backlog=''
	available="$(_proc_value net/ipv4/tcp_available_congestion_control)" || available=''
	openwrt_release="$(_openwrt_release)" || openwrt_release=''

	_module_present sch_cake && cake_mod=true || cake_mod=false
	case " $available " in
		*" bbr "*) bbr_mod=true ;;
		*) _module_present tcp_bbr && bbr_mod=true || bbr_mod=false ;;
	esac

	# sysctl.conf 加载在 sysctl.d 之后, 里面若残留同名键会压过本包的
	# drop-in。检出来让界面能说清楚, 而不是显示一个并未生效的值。
	if [ -f "$SYSCTL_CONF_PATH" ] && grep -qE "$TUNING_MANAGED_RE" "$SYSCTL_CONF_PATH" 2>/dev/null; then
		conflict=true
	else
		conflict=false
	fi

	irq_enabled="$(uci -q get irqbalance.irqbalance.enabled 2>/dev/null)"
	[ -n "$irq_enabled" ] || irq_enabled=0
	[ -x "$TUNING_INIT_DIR/irqbalance" ] && irq_installed=true || irq_installed=false
	# 用 procd 自己的 running 判定, 不用 pgrep: pgrep 会匹配任何同名进程,
	# 不管它是不是这个服务管起来的。
	if [ "$irq_installed" = true ] && "$TUNING_INIT_DIR/irqbalance" running >/dev/null 2>&1; then
		irq_running=true
	else
		irq_running=false
	fi

	printf '{"live":{"tcp_fastopen":"%s","default_qdisc":"%s","congestion_control":"%s","tcp_max_syn_backlog":"%s"},"available_congestion_control":"%s","openwrt_release":"%s","cake_module":%s,"bbr_module":%s,"sysctl_conf_conflict":%s,"irqbalance":{"installed":%s,"enabled":"%s","running":%s}}\n' \
		"$(printf '%s' "$fastopen" | json_string)" \
		"$(printf '%s' "$qdisc" | json_string)" \
		"$(printf '%s' "$cc" | json_string)" \
		"$(printf '%s' "$backlog" | json_string)" \
		"$(printf '%s' "$available" | json_string)" \
		"$(printf '%s' "$openwrt_release" | json_string)" \
		"$cake_mod" "$bbr_mod" "$conflict" \
		"$irq_installed" "$(printf '%s' "$irq_enabled" | json_string)" "$irq_running"
}

_tuning_apply() {
	local output rc
	if [ ! -x "$TUNING_APPLY" ]; then
		printf '{"code":1,"output":"tuning helper is missing"}\n'
		return 0
	fi
	output="$("$TUNING_APPLY" 2>&1)"
	rc=$?
	printf '{"code":%s,"output":"%s"}\n' "$rc" "$(printf '%s' "$output" | json_string)"
}

status_call() {
	config_load "$CONFIG"
	local enabled port password sub_url def output running health update_log pass_q template_q converted_url lan_ip lan_url conv_ver healthy a_name a_state a_code a_ts a_token extra config_digest config_error current
	config_get_bool enabled main enabled 0
	config_get port main port 9716
	config_error=''
	case "$port" in
		''|*[!0-9]*) config_error='invalid converter port'; port=0 ;;
		*) [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || { config_error='invalid converter port'; port=0; } ;;
	esac
	config_get password main password '890716'
	config_get sub_url main subscription_url ''
	config_get def main default_template momo_template
	config_get output main output_config '/etc/momo/profiles/config.json'
	if "$INIT" running >/dev/null 2>&1; then running=1; else running=0; fi
	pass_q=$(urlencode "$password")
	template_q=$(urlencode "$def")
	converted_url="http://127.0.0.1:${port}/?password=${pass_q}&template=${template_q}"
	lan_url=''
	if [ "$port" -gt 0 ] 2>/dev/null; then
		lan_ip=$(_lan_address 2>/dev/null) && \
			lan_url="http://${lan_ip}:${port}/?password=${pass_q}&template=${template_q}"
	fi
	if [ "$port" -gt 0 ] 2>/dev/null && health=$(_health_response "$port"); then
		healthy=true
		conv_ver=$(printf '%s' "$health" | jsonfilter -e '@.version' 2>/dev/null)
	else
		healthy=false
		health=''
		conv_ver=$(_converter_version)
		case "$conv_ver" in ''|unknown) config_error=${config_error:-'converter version unavailable'} ;; esac
	fi
	# Background operation state: "<name> <state> <code> <timestamp> <token>".
	a_name=''; a_state='idle'; a_code=0
	if [ -f "$ACTION_STATE" ]; then
		IFS=' ' read -r a_name a_state a_code a_ts a_token extra < "$ACTION_STATE" 2>/dev/null
		case "$a_name:$a_state:$a_code:$a_ts:$a_token:$extra" in
			refresh:running:*|refresh:done:*|check:running:*|check:done:*|update:running:*|update:done:*)
				case "$a_code:$a_ts:$a_token:$extra" in *[!0-9:A-Za-z._-]*|::*|*::*) a_name=''; a_state='corrupt'; a_code=1 ;; esac
				;;
			*) a_name=''; a_state='corrupt'; a_code=1 ;;
		esac
		if [ "$a_state" = running ]; then
			if _lock_read && [ "$LOCK_TOKEN" = "$a_token" ]; then
				current=$(_process_start "$LOCK_PID" 2>/dev/null || true)
				[ -n "$current" ] && [ "$current" = "$LOCK_START" ] || a_state='stale'
			else
				a_state='stale'
			fi
		fi
	fi
	config_digest=$(sha256sum /etc/liquid-formula/config.yaml 2>/dev/null | awk '{print $1}')
	case "$config_digest" in ''|*[!0-9a-f]*) config_digest=''; config_error=${config_error:-'generated config unavailable'} ;; esac
	update_log=$(tail -n 40 /var/log/liquid-formula/update.log 2>/dev/null | json_string)
	printf '{"enabled":%s,"running":%s,"healthy":%s,"port":%s,"subscription_set":%s,"default_template":"%s","output_config":"%s","converted_url":"%s","lan_url":"%s","converter_version":"%s","action":"%s","action_state":"%s","action_code":%s,"config_digest":"%s","config_error":"%s","health":"%s","update_log":"%s"}\n' \
		"$enabled" "$running" "$healthy" "$port" "$([ -n "$sub_url" ] && echo true || echo false)" \
		"$(printf '%s' "$def" | json_string)" \
		"$(printf '%s' "$output" | json_string)" \
		"$(printf '%s' "$converted_url" | json_string)" \
		"$(printf '%s' "$lan_url" | json_string)" \
		"$(printf '%s' "$conv_ver" | json_string)" \
		"$(printf '%s' "$a_name" | json_string)" \
		"$a_state" \
		"$a_code" \
		"$config_digest" \
		"$(printf '%s' "$config_error" | json_string)" \
		"$(printf '%s' "$health" | json_string)" \
		"$update_log"
}

