#!/bin/sh

umask 077
FUNCTIONS_SH=${SBF_FUNCTIONS_SH:-/lib/functions.sh}
. "$FUNCTIONS_SH" || exit 1
CONFIG=${SBF_CONFIG_NAME:-liquid_formula}
TPL_DIR=${SBF_TEMPLATE_DIR:-/www/liquid-formula/templates}
GEN=${SBF_GENERATOR:-/usr/share/liquid-formula/generate-config.sh}
UPDATE=${SBF_UPDATER:-/usr/share/liquid-formula/update.sh}
VALIDATE=${SBF_TEMPLATE_VALIDATOR:-/usr/share/liquid-formula/validate-template.sh}
INIT=${SBF_INIT_SCRIPT:-/etc/init.d/liquid-formula}
STATE_DIR=${SBF_STATE_DIR:-/var/run/liquid-formula}
ACTION_LOCK="$STATE_DIR/rpc-action.lock"
ACTION_STATE="$STATE_DIR/action.state"
ACTION_ERR="$STATE_DIR/action.err"
# Maximum valid dynamic budget: three 3,660-second phases plus startup/cleanup
# overhead. Invalid UCI will make the updater fail fast, but the fallback must
# never reintroduce a shorter watchdog than a valid operation may require.
ACTION_TIMEOUT_FALLBACK=11160
# rpcd captures the updater's stderr so failures outside update.log (exec
# errors, missing applets) stay diagnosable. update.log rotates at 256 KiB, but
# action.err had no ceiling at all — and it lives in /var/run, which is RAM on
# every router this ships to. Keep the tail; the head of a runaway error stream
# is never the interesting part.
ACTION_ERR_LIMIT=${SBF_ACTION_ERR_LIMIT:-65536}

# busybox 的 timeout applet 是可裁剪的, 并非所有固件都编入。缺失时降级为
# 直接执行: 丢掉看门狗, 也好过整个动作以 127 退出而根本不运行。
TIMEOUT_BIN=$(command -v timeout 2>/dev/null) || TIMEOUT_BIN=

_run_with_timeout() {
	local seconds="$1"
	shift
	if [ -n "$TIMEOUT_BIN" ]; then
		"$TIMEOUT_BIN" "$seconds" "$@"
		return $?
	fi
	"$@"
}

_count_action_template() {
	local sid="$1" enabled
	config_get_bool enabled "$sid" enabled 1
	[ "$enabled" != 1 ] || ACTION_TEMPLATE_COUNT=$((ACTION_TEMPLATE_COUNT + 1))
	return 0
}

_action_timeout() {
	# The updater's HTTP budget grows with subscription_timeout and every enabled
	# template. Check/apply may spend that budget once while a temporary converter
	# starts, once refreshing, and once fetching the selected template.
	local sub="$1" sub_timeout request_timeout seconds
	if ! config_load "$CONFIG" >/dev/null 2>&1; then
		printf '%s' "$ACTION_TIMEOUT_FALLBACK"
		return
	fi
	config_get sub_timeout main subscription_timeout 60
	case "$sub_timeout" in
		''|*[!0-9]*) printf '%s' "$ACTION_TIMEOUT_FALLBACK"; return ;;
	esac
	[ "$sub_timeout" -ge 5 ] 2>/dev/null && [ "$sub_timeout" -le 600 ] 2>/dev/null || {
		printf '%s' "$ACTION_TIMEOUT_FALLBACK"
		return
	}
	ACTION_TEMPLATE_COUNT=0
	config_foreach _count_action_template template >/dev/null 2>&1 || {
		printf '%s' "$ACTION_TIMEOUT_FALLBACK"
		return
	}
	request_timeout=$((sub_timeout * (ACTION_TEMPLATE_COUNT + 1) + 60))
	[ "$request_timeout" -le 3660 ] || request_timeout=3660
	case "$sub" in
		generate) seconds=120 ;;
		refresh) seconds=$((request_timeout + 30)) ;;
		check|apply) seconds=$((request_timeout * 3 + 180)) ;;
		*) seconds="$ACTION_TIMEOUT_FALLBACK" ;;
	esac
	printf '%s' "$seconds"
}


json_string() {
	# Emit a JSON-safe string body. Escapes backslash, double quote, newline and
	# ALL control characters (0x00-0x1F), including TAB, so tab-indented template
	# files and log lines never produce invalid JSON that ubus would reject.
	LC_ALL=C awk '
	BEGIN{ ORS=""; for(i=0;i<256;i++) ord[sprintf("%c",i)]=i }
	{
		if(NR>1) printf "\\n"
		n=length($0)
		for(i=1;i<=n;i++){
			c=substr($0,i,1); o=ord[c]
			if(c=="\\") printf "\\\\"
			else if(c=="\"") printf "\\\""
			else if(o<32){
				if(o==8) printf "\\b"
				else if(o==9) printf "\\t"
				else if(o==12) printf "\\f"
				else if(o==13) printf "\\r"
				else printf "\\u%04x", o
			}
			else printf "%s", c
		}
	}'
}

json_arg() {
	local key="$1" input="$2"
	printf '%s' "$input" | jsonfilter -e "@.$key" 2>/dev/null
}

valid_id() {
	case "$1" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
}

valid_file() {
	case "$1" in
		''|.*|*/*|*'..'*|*[!A-Za-z0-9._-]*|*.json.json) return 1 ;;
		*.json) [ "${#1}" -le 128 ] ;;
		*) return 1 ;;
	esac
}

valid_text() {
	! printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]'
}

template_reply_error() {
	printf '{"ok":false,"phase":"%s","error":"%s"}\n' \
		"$(printf '%s' "$1" | json_string)" "$(printf '%s' "$2" | json_string)"
}

restore_template_backup() {
	local backup="$1" destination="$2" restore
	restore=$(mktemp "$TPL_DIR/.template.restore.XXXXXX") || return 1
	cp -p "$backup" "$restore" && mv "$restore" "$destination" || {
		rm -f "$restore"
		return 1
	}
}

TEMPLATE_LOCK=
template_lock_acquire() {
	local current owner_pid owner_start extra self_start
	_secure_state_dir || return 1
	TEMPLATE_LOCK="$STATE_DIR/template.lock"
	if mkdir "$TEMPLATE_LOCK" 2>/dev/null; then
		self_start=$(_process_start $$) || { rmdir "$TEMPLATE_LOCK" 2>/dev/null; return 1; }
		case "$self_start" in ''|*[!0-9]*) rmdir "$TEMPLATE_LOCK" 2>/dev/null; return 1 ;; esac
		printf '%s %s\n' "$$" "$self_start" > "$TEMPLATE_LOCK/owner" || { rmdir "$TEMPLATE_LOCK" 2>/dev/null; return 1; }
		chmod 0600 "$TEMPLATE_LOCK/owner" || { rm -f "$TEMPLATE_LOCK/owner"; rmdir "$TEMPLATE_LOCK" 2>/dev/null; return 1; }
		return 0
	fi
	[ -d "$TEMPLATE_LOCK" ] && [ ! -L "$TEMPLATE_LOCK" ] || return 1
	IFS=' ' read -r owner_pid owner_start extra < "$TEMPLATE_LOCK/owner" 2>/dev/null || return 75
	[ -z "$extra" ] || return 75
	# Validate each field on its own. The old joined "$owner_pid:$owner_start"
	# form could never match its '' branch, because the join always contains a
	# colon, so an owner record with an empty PID or start time slipped through
	# and was then compared against an empty _process_start result.
	case "$owner_pid" in ''|*[!0-9]*) return 75 ;; esac
	case "$owner_start" in ''|*[!0-9]*) return 75 ;; esac
	current=$(_process_start "$owner_pid" 2>/dev/null || true)
	[ -z "$current" ] || [ "$current" != "$owner_start" ] || return 75
	rm -f "$TEMPLATE_LOCK/owner" && rmdir "$TEMPLATE_LOCK" || return 75
	template_lock_acquire
}

template_lock_release() {
	[ -n "$TEMPLATE_LOCK" ] || return 0
	rm -f "$TEMPLATE_LOCK/owner" 2>/dev/null
	rmdir "$TEMPLATE_LOCK" 2>/dev/null
	TEMPLATE_LOCK=
}

urlencode() {
	# RFC 3986 percent-encoder, byte-accurate (UTF-8 safe). Non-ASCII passwords
	# or template names are encoded per-byte, which is what the converter expects.
	printf '%s' "$1" | LC_ALL=C awk '
	BEGIN{ ORS=""; for(i=0;i<256;i++) ord[sprintf("%c",i)]=i }
	{
		n=length($0)
		for(i=1;i<=n;i++){
			c=substr($0,i,1)
			if(c ~ /[A-Za-z0-9._~-]/) printf "%s", c
			else printf "%%%02X", ord[c]
		}
	}'
}

_get_port() {
	local p
	p=$(uci -q get $CONFIG.main.port)
	case "$p" in ''|*[!0-9]*) p=9716 ;; esac
	printf '%s' "$p"
}

_health_response() {
	local port="$1" body service version status
	body=$(curl -fsS --connect-timeout 1 --max-time 2 "http://127.0.0.1:${port}/health" 2>/dev/null) || return 1
	service=$(printf '%s' "$body" | jsonfilter -e '@.service' 2>/dev/null) || return 1
	version=$(printf '%s' "$body" | jsonfilter -e '@.version' 2>/dev/null) || return 1
	status=$(printf '%s' "$body" | jsonfilter -e '@.status' 2>/dev/null) || return 1
	[ "$service" = 'singbox-subscribe-convert' ] || return 1
	[ "$status" = 'ok' ] || return 1
	case "$version" in ''|unknown) return 1 ;; esac
	printf '%s' "$body"
}

_health_ok() {
	_health_response "$1" >/dev/null
}

_wait_health() {
	# _wait_health <port> [max_seconds] - wait until /health answers
	local port="$1" max="${2:-6}" n=0
	while [ "$n" -lt "$max" ]; do
		_health_ok "$port" && return 0
		sleep 1
		n=$((n + 1))
	done
	_health_ok "$port"
}

_wait_gone() {
	local max="${1:-4}" n=0
	while [ "$n" -lt "$max" ]; do
		"$INIT" running >/dev/null 2>&1 || return 0
		sleep 1
		n=$((n + 1))
	done
	! "$INIT" running >/dev/null 2>&1
}

_process_start() {
	local pid="$1" line
	if [ -n "${SBF_PROCESS_START_HELPER:-}" ]; then
		"$SBF_PROCESS_START_HELPER" "$pid"
		return
	fi
	[ -r "/proc/$pid/stat" ] || return 1
	IFS= read -r line < "/proc/$pid/stat" || return 1
	printf '%s\n' "$line" | awk '{ sub(/^.*\) /, ""); split($0,f," "); print f[20] }'
}

_secure_state_dir() {
	mkdir -p "$STATE_DIR" || return 1
	[ -d "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ] || return 1
	chmod 0700 "$STATE_DIR"
}

LIFECYCLE_LOCK="$STATE_DIR/lifecycle.lock"
LIFECYCLE_TOKEN=
_lifecycle_lock_read() {
	local extra
	LIFECYCLE_PID=
	LIFECYCLE_START=
	LIFECYCLE_OWNER_TOKEN=
	[ -f "$LIFECYCLE_LOCK/owner" ] && [ ! -L "$LIFECYCLE_LOCK/owner" ] || return 1
	IFS=' ' read -r LIFECYCLE_PID LIFECYCLE_START LIFECYCLE_OWNER_TOKEN extra < "$LIFECYCLE_LOCK/owner" || return 1
	[ -z "$extra" ] || return 1
	case "$LIFECYCLE_PID" in ''|*[!0-9]*) return 1 ;; esac
	case "$LIFECYCLE_START" in ''|*[!0-9]*) return 1 ;; esac
	case "$LIFECYCLE_OWNER_TOKEN" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
}

_lifecycle_delegate_blocks_recovery() {
	local delegate="$LIFECYCLE_LOCK/delegate" extra current observed
	[ -e "$delegate" ] || [ -L "$delegate" ] || return 1
	LIFECYCLE_DELEGATE_PID=
	LIFECYCLE_DELEGATE_START=
	LIFECYCLE_DELEGATE_TOKEN=
	[ -f "$delegate" ] && [ ! -L "$delegate" ] || return 0
	IFS=' ' read -r LIFECYCLE_DELEGATE_PID LIFECYCLE_DELEGATE_START LIFECYCLE_DELEGATE_TOKEN extra < "$delegate" || return 0
	[ -z "$extra" ] || return 0
	case "$LIFECYCLE_DELEGATE_PID" in ''|*[!0-9]*) return 0 ;; esac
	case "$LIFECYCLE_DELEGATE_START" in ''|*[!0-9]*) return 0 ;; esac
	case "$LIFECYCLE_DELEGATE_TOKEN" in ''|*[!A-Za-z0-9._-]*) return 0 ;; esac
	current=$(_process_start "$LIFECYCLE_DELEGATE_PID" 2>/dev/null || true)
	if [ -n "$current" ] && [ "$current" = "$LIFECYCLE_DELEGATE_START" ]; then
		return 0
	fi
	observed=$(cat "$delegate" 2>/dev/null) || return 0
	[ "$observed" = "$LIFECYCLE_DELEGATE_PID $LIFECYCLE_DELEGATE_START $LIFECYCLE_DELEGATE_TOKEN" ] || return 0
	rm -f "$delegate" || return 0
	return 1
}

lifecycle_lock_acquire() {
	local parent current observed claim self_start attempts=0 empty_wait
	_secure_state_dir || return 1
	parent=${LIFECYCLE_LOCK%/*}
	self_start=$(_process_start $$) || return 1
	case "$self_start" in ''|*[!0-9]*) return 1 ;; esac
	LIFECYCLE_TOKEN="$$.$(date +%s).$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
	claim=$(mktemp "$parent/.lifecycle-owner.XXXXXX") || return 1
	printf '%s %s %s\n' "$$" "$self_start" "$LIFECYCLE_TOKEN" > "$claim" || {
		rm -f "$claim"
		return 1
	}
	chmod 0600 "$claim" || {
		rm -f "$claim"
		return 1
	}
	while [ "$attempts" -lt 3 ]; do
		if mkdir "$LIFECYCLE_LOCK" 2>/dev/null; then
			mv "$claim" "$LIFECYCLE_LOCK/owner" || {
				rmdir "$LIFECYCLE_LOCK" 2>/dev/null || true
				rm -f "$claim"
				return 1
			}
			return 0
		fi
		[ -d "$LIFECYCLE_LOCK" ] && [ ! -L "$LIFECYCLE_LOCK" ] || {
			rm -f "$claim"
			return 1
		}
		if [ ! -e "$LIFECYCLE_LOCK/owner" ]; then
			empty_wait=0
			while [ "$empty_wait" -lt 2 ] && [ ! -e "$LIFECYCLE_LOCK/owner" ]; do
				sleep 1
				empty_wait=$((empty_wait + 1))
			done
			if [ ! -e "$LIFECYCLE_LOCK/owner" ]; then
				if _lifecycle_delegate_blocks_recovery; then
					rm -f "$claim"
					return 75
				fi
				if rmdir "$LIFECYCLE_LOCK" 2>/dev/null; then
					attempts=$((attempts + 1))
					continue
				fi
				rm -f "$claim"
				return 75
			fi
		fi
		_lifecycle_lock_read || {
			rm -f "$claim"
			return 75
		}
		current=$(_process_start "$LIFECYCLE_PID" 2>/dev/null || true)
		if [ -n "$current" ] && [ "$current" = "$LIFECYCLE_START" ]; then
			rm -f "$claim"
			return 75
		fi
		if _lifecycle_delegate_blocks_recovery; then
			rm -f "$claim"
			return 75
		fi
		# Delegate inspection may have raced an ownership change.
		_lifecycle_lock_read || {
			rm -f "$claim"
			return 75
		}
		current=$(_process_start "$LIFECYCLE_PID" 2>/dev/null || true)
		if [ -n "$current" ] && [ "$current" = "$LIFECYCLE_START" ]; then
			rm -f "$claim"
			return 75
		fi
		observed=$(cat "$LIFECYCLE_LOCK/owner" 2>/dev/null) || {
			rm -f "$claim"
			return 75
		}
		[ "$observed" = "$LIFECYCLE_PID $LIFECYCLE_START $LIFECYCLE_OWNER_TOKEN" ] || {
			rm -f "$claim"
			return 75
		}
		rm -f "$LIFECYCLE_LOCK/owner" && rmdir "$LIFECYCLE_LOCK" || {
			rm -f "$claim"
			return 75
		}
		attempts=$((attempts + 1))
	done
	rm -f "$claim"
	return 75
}

lifecycle_lock_release() {
	local self_start
	[ -n "$LIFECYCLE_TOKEN" ] || return 0
	self_start=$(_process_start $$ 2>/dev/null) || return 0
	if _lifecycle_lock_read &&
		[ "$LIFECYCLE_PID" = "$$" ] &&
		[ "$LIFECYCLE_START" = "$self_start" ] &&
		[ "$LIFECYCLE_OWNER_TOKEN" = "$LIFECYCLE_TOKEN" ]; then
		rm -f "$LIFECYCLE_LOCK/owner" 2>/dev/null
		rmdir "$LIFECYCLE_LOCK" 2>/dev/null
	fi
	LIFECYCLE_TOKEN=
}

_state_write() {
	local action="$1" state="$2" code="$3" token="$4" tmp
	tmp=$(mktemp "$STATE_DIR/.action.state.XXXXXX") || return 1
	printf '%s %s %s %s %s\n' "$action" "$state" "$code" "$(date +%s)" "$token" > "$tmp" || { rm -f "$tmp"; return 1; }
	chmod 0600 "$tmp" || { rm -f "$tmp"; return 1; }
	mv "$tmp" "$ACTION_STATE"
}

_trim_action_err() {
	# Must run as the very last statement of the worker: mv replaces the file
	# the subshell's stderr is still attached to, so anything written after
	# this call lands in the unlinked inode and is lost.
	local size tmp
	size=$(wc -c < "$ACTION_ERR" 2>/dev/null) || return 0
	case "$size" in ''|*[!0-9]*) return 0 ;; esac
	[ "$size" -gt "$ACTION_ERR_LIMIT" ] || return 0
	tmp=$(mktemp "$STATE_DIR/.action.err.XXXXXX") || return 0
	{
		printf 'action.err truncated: kept the last %s of %s bytes\n' "$ACTION_ERR_LIMIT" "$size"
		tail -c "$ACTION_ERR_LIMIT" "$ACTION_ERR" 2>/dev/null
	} > "$tmp" || { rm -f "$tmp"; return 0; }
	chmod 0600 "$tmp" 2>/dev/null || true
	mv "$tmp" "$ACTION_ERR" 2>/dev/null || rm -f "$tmp"
	return 0
}

_lock_read() {
	local extra
	LOCK_PID= LOCK_START= LOCK_TOKEN=
	[ -f "$ACTION_LOCK/owner" ] && [ ! -L "$ACTION_LOCK/owner" ] || return 1
	IFS=' ' read -r LOCK_PID LOCK_START LOCK_TOKEN extra < "$ACTION_LOCK/owner" || return 1
	[ -z "$extra" ] || return 1
	# Per-field validation for the same reason as template_lock_acquire: the
	# joined form accepted a trailing empty field ("1:2:" contains no "::").
	case "$LOCK_PID" in ''|*[!0-9]*) return 1 ;; esac
	case "$LOCK_START" in ''|*[!0-9]*) return 1 ;; esac
	case "$LOCK_TOKEN" in ''|*[!0-9A-Za-z._-]*) return 1 ;; esac
}

_lock_acquire() {
	local current observed token claim parent self_start empty_wait attempts=0
	_secure_state_dir || return 1
	parent=${ACTION_LOCK%/*}
	token="$$.$(date +%s).$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
	self_start=$(_process_start $$) || return 1
	case "$self_start" in ''|*[!0-9]*) return 1 ;; esac
	claim=$(mktemp "$parent/.rpc-owner.XXXXXX") || return 1
	printf '%s %s %s\n' "$$" "$self_start" "$token" > "$claim" || { rm -f "$claim"; return 1; }
	chmod 0600 "$claim" || { rm -f "$claim"; return 1; }
	# Bounded retries. Recovering a stale lock used to recurse into
	# _lock_acquire with no depth limit, so a peer that kept re-claiming the
	# directory could drive the recursion arbitrarily deep. This matches the
	# three-attempt cap that lifecycle_lock_acquire already uses.
	while [ "$attempts" -lt 3 ]; do
		attempts=$((attempts + 1))
		if mkdir "$ACTION_LOCK" 2>/dev/null; then
			mv "$claim" "$ACTION_LOCK/owner" || { rmdir "$ACTION_LOCK" 2>/dev/null; rm -f "$claim"; return 1; }
			printf '%s' "$token"
			return 0
		fi
		[ -d "$ACTION_LOCK" ] && [ ! -L "$ACTION_LOCK" ] || { rm -f "$claim"; return 1; }
		if [ ! -e "$ACTION_LOCK/owner" ]; then
			empty_wait=0
			while [ "$empty_wait" -lt 2 ] && [ ! -e "$ACTION_LOCK/owner" ]; do sleep 1; empty_wait=$((empty_wait + 1)); done
			if [ ! -e "$ACTION_LOCK/owner" ]; then
				rmdir "$ACTION_LOCK" 2>/dev/null || { rm -f "$claim"; return 75; }
				continue
			fi
		fi
		_lock_read || { rm -f "$claim"; return 75; }
		current=$(_process_start "$LOCK_PID" 2>/dev/null || true)
		[ -z "$current" ] || [ "$current" != "$LOCK_START" ] || { rm -f "$claim"; return 75; }
		observed=$(cat "$ACTION_LOCK/owner" 2>/dev/null) || { rm -f "$claim"; return 75; }
		[ "$observed" = "$LOCK_PID $LOCK_START $LOCK_TOKEN" ] || { rm -f "$claim"; return 75; }
		if [ -e "$ACTION_LOCK/ready" ]; then
			[ -f "$ACTION_LOCK/ready" ] && [ ! -L "$ACTION_LOCK/ready" ] || { rm -f "$claim"; return 75; }
			rm -f "$ACTION_LOCK/ready" || { rm -f "$claim"; return 75; }
		fi
		rm -f "$ACTION_LOCK/owner" && rmdir "$ACTION_LOCK" || { rm -f "$claim"; return 75; }
	done
	rm -f "$claim"
	return 75
}

_lock_release_token() {
	local token="$1"
	_lock_read || return 0
	[ "$LOCK_TOKEN" = "$token" ] || return 0
	rm -f "$ACTION_LOCK/ready" 2>/dev/null
	rm -f "$ACTION_LOCK/owner" 2>/dev/null
	rmdir "$ACTION_LOCK" 2>/dev/null
}

_spawn_update() {
	local act="$1" sub="$2" token rc worker worker_start owner_tmp n action_timeout
	# 提前拦住 exec 层面的失败, 否则用户只会看到一个不透明的 126/127。
	if [ ! -f "$UPDATE" ]; then
		echo "updater $UPDATE is missing"
		return 1
	fi
	if [ ! -x "$UPDATE" ]; then
		echo "updater $UPDATE is not executable"
		return 1
	fi
	token=$(_lock_acquire) || { echo 'another operation is already running'; return 75; }
	action_timeout=$(_action_timeout "$sub")
	case "$action_timeout" in ''|*[!0-9]*) action_timeout="$ACTION_TIMEOUT_FALLBACK" ;; esac
	_state_write "$act" running 0 "$token" || { _lock_release_token "$token"; return 1; }
	: > "$ACTION_ERR" 2>/dev/null || true
	(
		n=0
		while [ ! -f "$ACTION_LOCK/ready" ] && [ "$n" -lt 5 ]; do sleep 1; n=$((n + 1)); done
		[ -f "$ACTION_LOCK/ready" ] || exit 1
		_run_with_timeout "$action_timeout" "$UPDATE" "$sub"
		rc=$?
		_state_write "$act" done "$rc" "$token"
		_lock_release_token "$token"
		_trim_action_err
	# stderr 必须落盘而不是丢弃: updater 之外的失败(exec 错误、缺少 applet)
	# 不会进 update.log, 丢掉之后就完全无从排查。stdout 仍走 /dev/null,
	# 因为 rpcd 要等插件的 stdout 关闭才会返回。
	) </dev/null >/dev/null 2>"$ACTION_ERR" &
	worker=$!
	worker_start=$(_process_start "$worker" 2>/dev/null) || {
		kill "$worker" 2>/dev/null || true
		_lock_release_token "$token"
		return 1
	}
	owner_tmp=$(mktemp "$STATE_DIR/.rpc-worker.XXXXXX") || {
		kill "$worker" 2>/dev/null || true
		_lock_release_token "$token"
		return 1
	}
	printf '%s %s %s\n' "$worker" "$worker_start" "$token" > "$owner_tmp" && chmod 0600 "$owner_tmp" && mv "$owner_tmp" "$ACTION_LOCK/owner" && : > "$ACTION_LOCK/ready" || {
		rm -f "$owner_tmp"
		kill "$worker" 2>/dev/null || true
		_lock_release_token "$token"
		return 1
	}
	echo queued
}

_service_action_locked() {
	local name="$1" port
	port=$(_get_port)
	case "$name" in
		start)
			LF_LIFECYCLE_TOKEN="$LIFECYCLE_TOKEN" "$INIT" start manual || { echo "start failed - see logread"; return 1; }
			if _wait_health "$port" 6; then
				echo "Converter started and healthy on port $port."
			else
				echo "Converter started, but the health endpoint is not answering yet - check the update log / logread."
			fi
			;;
		stop)
			# procd prints a harmless "service delete ... Not found" when the
			# service is not running; silence it so stop-from-stopped looks clean.
			LF_LIFECYCLE_TOKEN="$LIFECYCLE_TOKEN" "$INIT" stop >/dev/null 2>&1
			if _wait_gone 4; then
				echo "Converter stopped."
			else
				echo "Stop requested; the converter process is still terminating."
			fi
			;;
		restart)
			# Stop quietly, wait until the old process has actually exited so the
			# new one can rebind the port immediately (otherwise the fresh instance
			# fails to bind and only comes up after procd's respawn delay, which
			# makes a restart look ineffective), then start and wait for health.
			LF_LIFECYCLE_TOKEN="$LIFECYCLE_TOKEN" "$INIT" stop >/dev/null 2>&1
			_wait_gone 4
			LF_LIFECYCLE_TOKEN="$LIFECYCLE_TOKEN" "$INIT" start manual || { echo "restart failed at start - see logread"; return 1; }
			if _wait_health "$port" 6; then
				echo "Converter restarted and healthy on port $port."
			else
				echo "Converter restarted, but the health endpoint is not answering yet - check the update log / logread."
			fi
			;;
		*) echo "unknown service action: $name" >&2; return 2 ;;
	esac
}

service_action_cmd() {
	local name="$1" rc
	lifecycle_lock_acquire || {
		echo 'another service lifecycle operation is already running'
		return 75
	}
	_service_action_locked "$name"
	rc=$?
	lifecycle_lock_release
	return "$rc"
}

_valid_ipv4() {
	local ip="$1" part count=0 IFS
	case "$ip" in ''|*[!0-9.]*|.*|*.|*..*) return 1 ;; esac
	IFS='.'
	for part in $ip; do
		count=$((count + 1))
		[ "${#part}" -le 3 ] || return 1
		[ "$part" -le 255 ] 2>/dev/null || return 1
	done
	[ "$count" = 4 ]
}

# 取本机局域网 IPv4。优先问 ubus 要 lan 接口的实际地址, 因为 DHCP 客户端
# 模式下 UCI 里的 network.lan.ipaddr 可能是空的。
_lan_address() {
	local ip=''
	ip=$(ubus call network.interface.lan status 2>/dev/null \
		| jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
	if ! _valid_ipv4 "$ip"; then
		ip=$(uci -q get network.lan.ipaddr 2>/dev/null | awk '{print $1}')
	fi
	_valid_ipv4 "$ip" || return 1
	case "$ip" in 127.*) return 1 ;; esac
	printf '%s' "$ip"
}

_converter_version() {
	# Detect once from the target-built binary and cache only a recognizable
	# version. Never invent a fallback version: unknown identity fails closed.
	local f='/var/lib/liquid-formula/converter.version' bin='/usr/bin/sb-sub-c' v=''
	if [ -s "$f" ]; then
		v="$(cat "$f" 2>/dev/null)"
	fi
	# 校验必须和下面的探测正则同形。只认数字和点的话, 0.7.2-formula 这种带
	# 后缀的版本永远读不出缓存, 界面每 5 秒轮询就重跑一次 --version。
	case "$v" in
		''|.*|*.|*[!0-9.A-Za-z-]*|-*|*-) v='' ;;
		[!0-9]*) v='' ;;
	esac
	if [ -z "$v" ]; then
		[ -x "$bin" ] && v="$(_run_with_timeout 3 "$bin" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+([.][0-9]+)?(-[A-Za-z0-9.]+)?' | head -n1)"
		if [ -n "$v" ]; then
			mkdir -p /var/lib/liquid-formula 2>/dev/null
			printf '%s' "$v" > "$f" 2>/dev/null
		fi
	fi
	printf '%s' "${v:-unknown}"
}

