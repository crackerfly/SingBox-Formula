}

# 只快照/恢复涉及的那一个模板 section。
#
# 原先的做法是 "uci delete 整个 liquid_formula" 再 "uci import 快照"。模板锁
# 只保护模板 RPC, 拦不住普通的 Overview 保存 —— 于是另一个会话在快照之后提交
# 的端口、密码、订阅地址会被静默回退成快照时的旧值。
template_hex_encode() {
	LC_ALL=C awk '
		BEGIN { ORS=""; for (i=0; i<256; i++) ord[sprintf("%c",i)]=i }
		{
			if (NR > 1) printf "0a"
			for (i=1; i<=length($0); i++) printf "%02x", ord[substr($0,i,1)]
		}'
}

template_hex_decode() {
	LC_ALL=C awk '
		function hex(c) {
			c=tolower(c)
			return index("0123456789abcdef", c) - 1
		}
		{
			if (length($0) % 2) exit 1
			for (i=1; i<=length($0); i+=2) {
				hi=hex(substr($0,i,1)); lo=hex(substr($0,i+1,1))
				if (hi < 0 || lo < 0) exit 1
				printf "%c", hi * 16 + lo
			}
	}'
}

TEMPLATE_SNAPSHOT_OUTPUT=
TEMPLATE_SNAPSHOT_OPTION_HEX=
TEMPLATE_SNAPSHOT_LIST_COUNT=0
TEMPLATE_SNAPSHOT_ERROR=0
template_snapshot_list_item() {
	local value="$1" value_hex
	value_hex=$(printf '%s' "$value" | template_hex_encode) || {
		TEMPLATE_SNAPSHOT_ERROR=1
		return 1
	}
	printf 'L:%s:%s\n' "$TEMPLATE_SNAPSHOT_OPTION_HEX" "$value_hex" >> "$TEMPLATE_SNAPSHOT_OUTPUT" || {
		TEMPLATE_SNAPSHOT_ERROR=1
		return 1
	}
	TEMPLATE_SNAPSHOT_LIST_COUNT=$((TEMPLATE_SNAPSHOT_LIST_COUNT + 1))
}

template_section_snapshot() {
	local id="$1" output="$2" section="$CONFIG.$id" type shown line key option value seen=' ' option_hex
	: > "$output" || return 1
	type=$(uci -q get "$section" 2>/dev/null) || {
		printf 'A\n' > "$output"
		return $?
	}
	shown=$(uci -q show "$section" 2>/dev/null) || return 1
	command -v config_list_foreach >/dev/null 2>&1 || return 1
	printf 'S:%s\n' "$(printf '%s' "$type" | template_hex_encode)" > "$output" || return 1
	printf '%s\n' "$shown" |
		while IFS= read -r line; do
			key=${line%%=*}
			[ "$key" != "$section" ] || continue
			case "$key" in
				"$section".*) option=${key#"$section".} ;;
				*) return 1 ;;
			esac
			case "$option" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
			case "$seen" in *" $option "*) continue ;; esac
			seen="$seen$option "
			option_hex=$(printf '%s' "$option" | template_hex_encode) || return 1
			TEMPLATE_SNAPSHOT_OUTPUT=$output
			TEMPLATE_SNAPSHOT_OPTION_HEX=$option_hex
			TEMPLATE_SNAPSHOT_LIST_COUNT=0
			TEMPLATE_SNAPSHOT_ERROR=0
			config_list_foreach "$id" "$option" template_snapshot_list_item || return 1
			[ "$TEMPLATE_SNAPSHOT_ERROR" = 0 ] || return 1
			if [ "$TEMPLATE_SNAPSHOT_LIST_COUNT" = 0 ]; then
				value=$(uci -q get "$key" 2>/dev/null) || return 1
				printf 'O:%s:%s\n' "$option_hex" \
					"$(printf '%s' "$value" | template_hex_encode)" >> "$output" || return 1
			fi
		done >> "$output"
}

template_section_restore() {
	local id="$1" snapshot="$2" section="$CONFIG.$id" line rest record type option value seen_scalar=' ' seen_list=' '
	[ -f "$snapshot" ] || return 1
	IFS= read -r line < "$snapshot" || return 1
	if ! uci -q delete "$section" 2>/dev/null && uci -q get "$section" >/dev/null 2>&1; then
		return 1
	fi
	if [ "$line" = A ]; then
		# A means the section did not exist when the transaction began.
		uci commit "$CONFIG" >/dev/null 2>&1 || return 1
		return 0
	fi
	case "$line" in S:*) ;; *) return 1 ;; esac
	type=$(printf '%s\n' "${line#S:}" | template_hex_decode) || return 1
	case "$type" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
	uci -q set "$section=$type" || {
		uci -q revert "$section" >/dev/null 2>&1 || true
		return 1
	}
	sed '1d' "$snapshot" |
	while IFS= read -r line; do
		case "$line" in
			O:*:*) record=O ;;
			L:*:*) record=L ;;
			*)
				uci -q revert "$section" >/dev/null 2>&1 || true
				return 1
				;;
		esac
		rest=${line#?:}
		option=$(printf '%s\n' "${rest%%:*}" | template_hex_decode) || {
			uci -q revert "$section" >/dev/null 2>&1 || true
			return 1
		}
		value=$(printf '%s\n' "${rest#*:}" | template_hex_decode) || {
			uci -q revert "$section" >/dev/null 2>&1 || true
			return 1
		}
		case "$option" in
			''|*[!A-Za-z0-9_]*)
				uci -q revert "$section" >/dev/null 2>&1 || true
				return 1
				;;
		esac
		if [ "$record" = O ]; then
			case "$seen_scalar" in
				*" $option "*)
					uci -q revert "$section" >/dev/null 2>&1 || true
					return 1
					;;
			esac
			case "$seen_list" in
				*" $option "*)
					uci -q revert "$section" >/dev/null 2>&1 || true
					return 1
					;;
			esac
			seen_scalar="$seen_scalar$option "
			uci -q set "$section.$option=$value" || {
				uci -q revert "$section" >/dev/null 2>&1 || true
				return 1
			}
		else
			case "$seen_scalar" in
				*" $option "*)
					uci -q revert "$section" >/dev/null 2>&1 || true
					return 1
					;;
			esac
			seen_list="$seen_list$option "
			uci -q add_list "$section.$option=$value" || {
				uci -q revert "$section" >/dev/null 2>&1 || true
				return 1
			}
		fi
	done || return 1
	uci commit "$CONFIG" >/dev/null 2>&1 || {
		uci -q revert "$section" >/dev/null 2>&1 || true
		return 1
	}
	return 0
}

write_template_call() {
	local input id name file no_node enabled content stage backup uci_backup restart_note old_file def file_owner message existed=0 file_installed=0 committed=0 backup_restored=0 uci_restored=0 config_restored=0
	input=$(cat)
	id=$(json_arg id "$input")
	name=$(json_arg name "$input")
	file=$(json_arg file "$input")
	no_node=$(json_arg no_node "$input")
	enabled=$(json_arg enabled "$input")
	content=$(json_arg content "$input")
	valid_id "$id" || { template_reply_error validate 'invalid template id'; return 1; }
	valid_file "$file" || { template_reply_error validate 'invalid template file'; return 1; }
	valid_text "$name" && valid_text "$no_node" || { template_reply_error validate 'template metadata contains control characters'; return 1; }
	[ "$(printf '%s' "$content" | wc -c)" -le 1048576 ] 2>/dev/null || { template_reply_error validate 'template exceeds 1 MiB'; return 1; }
	[ -n "$name" ] || name="$id"
	[ -n "$no_node" ] || no_node='➜ Direct'
	case "$enabled" in true|1|yes|on) enabled=1 ;; *) enabled=0 ;; esac
	template_lock_acquire || { template_reply_error lock 'another template operation is running'; return 75; }
	mkdir -p "$TPL_DIR" || { template_lock_release; template_reply_error stage 'cannot create template directory'; return 1; }
	[ -d "$TPL_DIR" ] && [ ! -L "$TPL_DIR" ] || { template_lock_release; template_reply_error validate 'unsafe template directory'; return 1; }
	stage=$(mktemp "$TPL_DIR/.template.new.XXXXXX") || { template_lock_release; template_reply_error stage 'cannot create staging file'; return 1; }
	backup=$(mktemp "$STATE_DIR/.template.backup.XXXXXX") || { rm -f "$stage"; template_lock_release; template_reply_error stage 'cannot create backup'; return 1; }
	uci_backup=$(mktemp "$STATE_DIR/.template.uci.XXXXXX") || { rm -f "$stage" "$backup"; template_lock_release; template_reply_error stage 'cannot snapshot UCI'; return 1; }
	if ! printf '%s' "$content" > "$stage" || ! chmod 0600 "$stage" || ! "$VALIDATE" "$stage" >/dev/null 2>&1; then
		rm -f "$stage" "$backup" "$uci_backup"; template_lock_release; template_reply_error validate 'template validation failed'; return 1
	fi
	config_load "$CONFIG"
	file_owner=''
	_find_file_owner() {
		local candidate="$1" candidate_file
		[ "$candidate" = "$id" ] && return 0
		config_get candidate_file "$candidate" file ''
		[ "$candidate_file" != "$file" ] || file_owner="$candidate"
	}
	config_foreach _find_file_owner template
	[ -z "$file_owner" ] || { rm -f "$stage" "$backup" "$uci_backup"; template_lock_release; template_reply_error validate 'template file is already owned by another id'; return 1; }
	config_get def main default_template momo_template
	[ "$id" = "$def" ] && [ "$enabled" = 0 ] && { rm -f "$stage" "$backup" "$uci_backup"; template_lock_release; template_reply_error validate 'cannot disable current default_template'; return 1; }
	if uci -q get "$CONFIG.$id" >/dev/null 2>&1; then
		existed=1; config_get old_file "$id" file ''
		[ "$old_file" = "$file" ] || { rm -f "$stage" "$backup" "$uci_backup"; template_lock_release; template_reply_error validate 'template id and file are immutable'; return 1; }
	fi
	template_section_snapshot "$id" "$uci_backup" || { rm -f "$stage" "$backup" "$uci_backup"; template_lock_release; template_reply_error snapshot 'cannot snapshot the template section'; return 1; }
	if [ -e "$TPL_DIR/$file" ]; then
		[ -f "$TPL_DIR/$file" ] && [ ! -L "$TPL_DIR/$file" ] || { rm -f "$stage" "$backup" "$uci_backup"; template_lock_release; template_reply_error validate 'unsafe template destination'; return 1; }
		cp -p "$TPL_DIR/$file" "$backup" || { rm -f "$stage" "$backup" "$uci_backup"; template_lock_release; template_reply_error snapshot 'cannot back up template'; return 1; }
	else
		rm -f "$backup"; backup=''
	fi
	if mv "$stage" "$TPL_DIR/$file"; then
		stage=''
		chmod 0644 "$TPL_DIR/$file" && file_installed=1
	fi
	if [ "$file_installed" = 1 ]; then
		if [ "$existed" = 1 ] || uci set "$CONFIG.$id=template"; then
			uci set "$CONFIG.$id.enabled=$enabled" && uci set "$CONFIG.$id.name=$name" && uci set "$CONFIG.$id.file=$file" && uci set "$CONFIG.$id.no_node=$no_node" && uci commit "$CONFIG" && "$GEN" >/dev/null 2>&1 && committed=1
		fi
	fi
	if [ "$committed" != 1 ]; then
		if [ -n "$backup" ]; then
			restore_template_backup "$backup" "$TPL_DIR/$file" 2>/dev/null && backup_restored=1
		else
			rm -f "$TPL_DIR/$file" &&
				[ ! -e "$TPL_DIR/$file" ] &&
				[ ! -L "$TPL_DIR/$file" ] &&
				backup_restored=1
		fi
		template_section_restore "$id" "$uci_backup" && uci_restored=1
		# 生成器可能已经写出了一份不含/含有该模板的 config.yaml。UCI 回滚之后
		# 必须重新生成, 否则磁盘上的配置和 UCI 对不上。
		if [ "$backup_restored" = 1 ] && [ "$uci_restored" = 1 ] && "$GEN" >/dev/null 2>&1; then
			config_restored=1
		fi
		[ -z "$stage" ] || rm -f "$stage"
		if [ "$backup_restored" = 1 ] && [ "$uci_restored" = 1 ] && [ "$config_restored" = 1 ]; then
			rm -f "$backup" "$uci_backup"
			message='template transaction failed and was rolled back'
		else
			message="template transaction failed; rollback was incomplete and recovery artifacts were retained"
			[ -z "$backup" ] || message="$message (file: $backup)"
			message="$message (UCI: $uci_backup)"
		fi
		template_lock_release; template_reply_error rollback "$message"; return 1
	fi
	[ -z "$stage" ] || rm -f "$stage"
	rm -f "$backup" "$uci_backup"
	template_lock_release
	# restart 失败原先被完全吞掉并返回 ok:true。磁盘上的模板已经变了, 而运行中
	# 的进程还在用旧的 —— 必须让调用方知道。
	restart_note=''
	if lifecycle_lock_acquire; then
		if "$INIT" running >/dev/null 2>&1; then
			LF_LIFECYCLE_TOKEN="$LIFECYCLE_TOKEN" "$INIT" restart >/dev/null 2>&1 || \
				restart_note='saved, but the converter could not be restarted; it is still using the previous template'
		fi
		lifecycle_lock_release
	else
		restart_note='saved, but another converter lifecycle operation is running; restart was not attempted'
	fi
	if [ -n "$restart_note" ]; then
		printf '{"ok":true,"phase":"complete","id":"%s","file":"%s","warning":"%s"}\n' \
			"$id" "$(printf '%s' "$file" | json_string)" "$(printf '%s' "$restart_note" | json_string)"
	else
		printf '{"ok":true,"phase":"complete","id":"%s","file":"%s"}\n' "$id" "$(printf '%s' "$file" | json_string)"
	fi
}

delete_template_call() {
	local input id file def backup uci_backup backup_restored=0 uci_restored=0 config_restored=0 message restart_note
	input=$(cat)
	id=$(json_arg id "$input")
	valid_id "$id" || { template_reply_error validate 'invalid template id'; return 1; }
	template_lock_acquire || { template_reply_error lock 'another template operation is running'; return 75; }
	config_load "$CONFIG"
	config_get def main default_template momo_template
	[ "$id" = "$def" ] && { template_lock_release; template_reply_error validate 'cannot delete current default_template'; return 1; }
	config_get file "$id" file ''
	valid_file "$file" || { template_lock_release; template_reply_error lookup 'template metadata is invalid'; return 1; }
	[ ! -L "$TPL_DIR/$file" ] || { template_lock_release; template_reply_error validate 'unsafe template destination'; return 1; }
	backup=$(mktemp "$STATE_DIR/.template.delete.XXXXXX") || { template_lock_release; template_reply_error snapshot 'cannot create backup'; return 1; }
	uci_backup=$(mktemp "$STATE_DIR/.template.uci.XXXXXX") || { rm -f "$backup"; template_lock_release; template_reply_error snapshot 'cannot snapshot UCI'; return 1; }
	template_section_snapshot "$id" "$uci_backup" || { rm -f "$backup" "$uci_backup"; template_lock_release; template_reply_error snapshot 'cannot snapshot the template section'; return 1; }
	if [ -f "$TPL_DIR/$file" ]; then
		cp -p "$TPL_DIR/$file" "$backup" || {
			rm -f "$backup" "$uci_backup"
			template_lock_release
			template_reply_error snapshot 'cannot back up template'
			return 1
		}
	else
		rm -f "$backup"
		backup=''
	fi
	if ! uci -q delete "$CONFIG.$id" || ! uci commit "$CONFIG" || ! "$GEN" >/dev/null 2>&1 || ! rm -f "$TPL_DIR/$file"; then
		if [ -z "$backup" ]; then
			rm -f "$TPL_DIR/$file" && [ ! -e "$TPL_DIR/$file" ] && [ ! -L "$TPL_DIR/$file" ] && backup_restored=1
		elif restore_template_backup "$backup" "$TPL_DIR/$file" 2>/dev/null; then
			backup_restored=1
		fi
		template_section_restore "$id" "$uci_backup" && uci_restored=1
		# 生成器可能已经成功跑过(比如后面的 rm 才失败), 那份 config.yaml 里
		# 已经没有这个模板了。回滚 UCI 之后必须重新生成。
		if [ "$backup_restored" = 1 ] && [ "$uci_restored" = 1 ] && "$GEN" >/dev/null 2>&1; then
			config_restored=1
		fi
		if [ "$backup_restored" = 1 ] && [ "$uci_restored" = 1 ] && [ "$config_restored" = 1 ]; then
			rm -f "$backup" "$uci_backup"
			message='delete transaction failed and was rolled back'
		else
			message="delete transaction failed; rollback was incomplete and recovery artifacts were retained"
			[ -z "$backup" ] || message="$message (file: $backup)"
			message="$message (UCI: $uci_backup)"
		fi
		template_lock_release; template_reply_error rollback "$message"; return 1
	fi
	rm -f "$backup" "$uci_backup"
	template_lock_release
	restart_note=''
	if lifecycle_lock_acquire; then
		if "$INIT" running >/dev/null 2>&1; then
			LF_LIFECYCLE_TOKEN="$LIFECYCLE_TOKEN" "$INIT" restart >/dev/null 2>&1 || \
				restart_note='deleted, but the converter could not be restarted; it is still using the previous template set'
		fi
		lifecycle_lock_release
	else
		restart_note='deleted, but another converter lifecycle operation is running; restart was not attempted'
	fi
	if [ -n "$restart_note" ]; then
		printf '{"ok":true,"phase":"complete","warning":"%s"}\n' "$(printf '%s' "$restart_note" | json_string)"
	else
		printf '{"ok":true,"phase":"complete"}\n'
	fi
}

case "$1" in
	list)
		cat <<'EOF'
{
  "status": {},
  "service_action": { "name": "" },
  "generate": {},
  "refresh": {},
  "check": {},
  "update": {},
  "list_templates": {},
  "read_template": { "id": "", "file": "" },
  "write_template": { "id": "", "name": "", "file": "", "no_node": "", "enabled": true, "content": "" },
  "delete_template": { "id": "" },
  "tuning_status": {},
  "tuning_apply": {}
}
EOF
		;;
	call)
		case "$2" in
			status) status_call ;;
			service_action)
				input=$(cat); name=$(json_arg name "$input")
				out=$(service_action_cmd "$name" 2>&1); rc=$?
				printf '{"code":%s,"output":"%s"}\n' "$rc" "$(printf '%s' "$out" | json_string)"
				;;
			generate)
				out=$("$GEN" 2>&1); rc=$?
				printf '{"code":%s,"output":"%s"}\n' "$rc" "$(printf '%s' "$out" | json_string)"
				;;
			refresh|check|update)
				method="$2"; sub="$method"; [ "$method" = update ] && sub=apply
				out=$(_spawn_update "$method" "$sub" 2>&1); rc=$?
				printf '{"code":%s,"output":"%s"}\n' "$rc" "$(printf '%s' "$out" | json_string)"
				;;
			list_templates) list_templates_call ;;
			read_template) read_template_call ;;
			write_template) write_template_call ;;
			tuning_status) _tuning_status ;;
			tuning_apply) _tuning_apply ;;
			delete_template) delete_template_call ;;
			*) printf '{"error":"unknown method"}\n'; exit 1 ;;
		esac
		;;
	*)
		echo "usage: $0 {list|call method}" >&2
		exit 1
		;;
esac
