# This file is generated from /etc/config/liquid_formula.
# Do not edit manually; use LuCI or run:
#   /usr/share/liquid-formula/generate-config.sh
server:
  port: 9716
  read_timeout: 15
  write_timeout: 240
  idle_timeout: 60

auth:
  password: '890716'

subscription:
  url: 'http://127.0.0.1:9717/v1/aggregate'
  user_agent: 'sing-box 1.11.0'
  timeout: 120
  refresh_interval: 360

liquid_formula_gateway:
  listen_address: '127.0.0.1'
  listen_port: 9717
  source_timeout: 60
  aggregate_timeout: 120
  user_agent: 'sing-box 1.11.0'
  urls: []

templates:
  momo_template:
    url: 'http://127.0.0.1/liquid-formula/templates/momo-template.json'
    name: 'Momo Template'
    no_node: '➜ Direct'
    enabled: true

default_template: 'momo_template'

cache:
  directory: '/var/lib/liquid-formula/cache'
  node_file: 'node.json'
  template_file: 'template.json'

cloudflare:
  enabled: false
  purge_url: ''
  api_token: ''
  api_key: ''
  api_email: ''

logging:
  production: true
  file: '/var/log/liquid-formula/server.log'
  level: 'info'
  max_size: 10
  max_backups: 3
  max_age: 7
