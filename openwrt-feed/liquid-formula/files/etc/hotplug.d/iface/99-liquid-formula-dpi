#!/bin/sh

# Keep NFQUEUE bindings in sync with WAN link changes. Hotplug scripts are
# sourced by netifd, so this file deliberately falls through without exit.

tf_common="${LFDPI_COMMON:-/usr/share/liquid-formula-dpi/service-common.sh}"
tf_network_helpers="${LFDPI_NETWORK_HELPERS:-/lib/functions/network.sh}"
tf_wan_resolver="${LFDPI_WAN_RESOLVER:-/usr/share/liquid-formula-dpi/wan-resolver.sh}"
tf_init_dir="${LFDPI_INIT_DIR:-/etc/init.d}"

tf_hotplug_log() {
	logger -t liquid-formula-hotplug -- "$*" 2>/dev/null || true
}

tf_hotplug_device() {
	local resolved=''

	if [ -n "${DEVICE:-}" ]; then
		printf '%s\n' "$DEVICE"
		return 0
	fi
	[ -n "${INTERFACE:-}" ] || return 1
	if command -v network_get_device >/dev/null 2>&1; then
		command -v network_flush_cache >/dev/null 2>&1 && network_flush_cache
		network_get_device resolved "$INTERFACE" 2>/dev/null || resolved=''
	fi
	if [ -z "$resolved" ]; then
		resolved="$(tf_hotplug_device_cache_get "$INTERFACE" 2>/dev/null || true)"
	fi
	[ -n "$resolved" ] || return 1
	printf '%s\n' "$resolved"
}

tf_hotplug_selected_matches() {
	local service="$1" device="$2" iface

	for iface in $(uci -q get "$service.main.interface" 2>/dev/null); do
		[ "$iface" = "$device" ] && return 0
	done
	return 1
}

tf_hotplug_auto_up_device() {
	local service="$1" family="$2" matched_device=''

	[ -n "${INTERFACE:-}" ] && tf_valid_network_name "$INTERFACE" || return 1
	tf_wan_resolve "$family" || return 1
	if [ "$INTERFACE" = "$TF_WAN_IPV4_NETWORK" ]; then
		matched_device="$TF_WAN_IPV4_DEVICE"
	elif [ "$INTERFACE" = "$TF_WAN_IPV6_NETWORK" ]; then
		matched_device="$TF_WAN_IPV6_DEVICE"
	fi
	tf_interface_exists "$matched_device" || return 1
	printf '%s\n' "$matched_device"
}

tf_hotplug_auto_down_device() {
	local service="$1" family="$2" matched_device=''

	[ -n "${INTERFACE:-}" ] && tf_valid_network_name "$INTERFACE" || return 1
	tf_wan_state_get "$service" || return 1
	if [ "$INTERFACE" = "$TF_WAN_STORED_IPV4_NETWORK" ]; then
		matched_device="$TF_WAN_STORED_IPV4_DEVICE"
	elif [ "$INTERFACE" = "$TF_WAN_STORED_IPV6_NETWORK" ]; then
		matched_device="$TF_WAN_STORED_IPV6_DEVICE"
	fi
	tf_valid_interface "$matched_device" || return 1

	# Re-resolve after recognizing the old mapping. Do not replace the stored
	# state here: the service needs the old device to authenticate this event
	# before it atomically installs the surviving mapping.
	tf_wan_resolve "$family" >/dev/null 2>&1 || true
	printf '%s\n' "$matched_device"
}

tf_hotplug_main() {
	local tf_command tf_device tf_service tf_mode tf_family tf_network

	case "${ACTION:-}" in
		ifdown) tf_command=link_down ;;
		ifup) tf_command=link_up ;;
		*) return 0 ;;
	esac

	[ -r "$tf_common" ] || {
		tf_hotplug_log "shared service helper is unavailable"
		return 0
	}
	# shellcheck source=/dev/null
	. "$tf_common"
	if [ -r "$tf_network_helpers" ]; then
		# shellcheck source=/dev/null
		. "$tf_network_helpers"
	fi
	[ -r "$tf_wan_resolver" ] || {
		tf_hotplug_log "WAN resolver helper is unavailable"
		return 0
	}
	# shellcheck source=/dev/null
	. "$tf_wan_resolver"

	for tf_service in fakehttp fakesip; do
		tf_network=''
		[ -x "$tf_init_dir/$tf_service" ] || continue
		[ "$(uci -q get "$tf_service.main.enabled" 2>/dev/null)" = 1 ] || continue

		tf_mode="$(uci -q get "$tf_service.main.interface_mode" 2>/dev/null)"
		[ -n "$tf_mode" ] || tf_mode=auto
		case "$tf_mode" in
			auto)
				tf_network="${INTERFACE:-}"
				tf_family="$(uci -q get "$tf_service.main.family" 2>/dev/null)"
				case "$tf_family" in ipv4|ipv6|dual) ;; *) tf_family=dual ;; esac
				if [ "$tf_command" = link_up ]; then
					tf_device="$(tf_hotplug_auto_up_device "$tf_service" "$tf_family" 2>/dev/null || true)"
				else
					tf_device="$(tf_hotplug_auto_down_device "$tf_service" "$tf_family" 2>/dev/null || true)"
				fi
				if ! tf_valid_interface "$tf_device"; then
					tf_hotplug_log "ignoring ${ACTION:-unknown} for unrelated or unavailable auto WAN"
					continue
				fi
				;;
			selected|all)
				[ "$tf_service" = fakehttp ] || [ "$tf_mode" = selected ] || continue
				tf_device="$(tf_hotplug_device 2>/dev/null || true)"
				if ! tf_valid_interface "$tf_device"; then
					tf_hotplug_log "ignoring ${ACTION:-unknown} without a uniquely resolved device"
					continue
				fi
				if [ "$tf_command" = link_up ] && ! tf_interface_exists "$tf_device"; then
					tf_hotplug_log "ignoring ifup for unavailable device: $tf_device"
					continue
				fi
				if [ "$tf_command" = link_up ] && [ -n "${INTERFACE:-}" ]; then
					tf_hotplug_device_cache_set "$INTERFACE" "$tf_device" ||
						tf_hotplug_log "unable to cache ${INTERFACE} L3 device: $tf_device"
				fi
				if [ "$tf_mode" = selected ] &&
				   ! tf_hotplug_selected_matches "$tf_service" "$tf_device"; then
					continue
				fi
				;;
			*) continue ;;
		esac

		if [ -n "$tf_network" ]; then
			"$tf_init_dir/$tf_service" "$tf_command" "$tf_device" "$tf_network" \
				>/dev/null 2>&1 || true
		else
			"$tf_init_dir/$tf_service" "$tf_command" "$tf_device" >/dev/null 2>&1 || true
		fi
	done
}

tf_hotplug_main
unset tf_common tf_network_helpers tf_wan_resolver tf_init_dir
